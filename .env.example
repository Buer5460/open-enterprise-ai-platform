# OpenEnterpriseAI environment template
# Copy to .env only in your deployment environment. Never commit real secrets.

# -----------------------------------------------------------------------------
# Runtime mode
# -----------------------------------------------------------------------------
# development: local bootstrap login is enabled by default.
# production: local bootstrap login is disabled by default and protected API
# routes require a valid server-side session.
OEAP_DEPLOYMENT_MODE=development
NODE_ENV=development

# Explicit override. Usually leave empty in development and set disabled in
# production. Avoid enabling this on Internet-facing deployments.
OEAP_LOCAL_AUTH=

# Session lifetime. Production default is 8 hours; development default 24.
OEAP_SESSION_TTL_HOURS=8

# Optional organization preference when the same external login email belongs
# to multiple OEAP organizations.
OEAP_DEFAULT_ORG_ID=org_local

# -----------------------------------------------------------------------------
# API / Web runtime
# -----------------------------------------------------------------------------
OEAP_API_HOST=127.0.0.1
OEAP_API_PORT=8787
OEAP_WEB_PORT=5173
OEAP_HTTP_PORT=8080

# Set true when API requests arrive through a trusted reverse proxy such as the
# supplied nginx container. Do not enable for untrusted direct client traffic.
OEAP_TRUST_PROXY=false

# Example production same-origin values:
# OEAP_PUBLIC_WEB_URL=https://ai.example.com
# OEAP_PUBLIC_API_URL=https://ai.example.com
# For a separate Web/API origin, set OEAP_CORS_ORIGINS to the approved Web URL.
OEAP_PUBLIC_WEB_URL=
OEAP_PUBLIC_API_URL=
OEAP_CORS_ORIGINS=

# Durable runtime storage. The supplied Docker Compose stack mounts persistent
# runtime state here. Generated apps, SQLite databases and encrypted settings
# all obey OEAP_DATA_DIR.
OEAP_DATA_DIR=

# -----------------------------------------------------------------------------
# AI Runtime
# -----------------------------------------------------------------------------
# auto: use a complete organization/server OpenAI-compatible configuration;
# otherwise fall back to DeepSeek Harness.
# deepseek-harness: force the local Harness runtime.
# openai-compatible: force a compatible chat-completions API.
OEAP_AI_PROVIDER=auto

# DeepSeek Harness. The UI can use it without any OpenAI-compatible settings.
# Optional host-side checkout used by docker-compose.yml.
OEAP_HARNESS_HOST_PATH=./.harness-placeholder
# Local launcher overrides when repositories are not siblings.
OEAP_OPEN_ENTERPRISE_ROOT=
OEAP_HARNESS_ROOT=
OEAP_DSH_HOME=
# Harness headless-call timeout in milliseconds.
OEAP_AI_TIMEOUT_MS=120000

# Deployment-level OpenAI-compatible fallback. Enterprise administrators can
# instead configure Base URL / Model / API Key from AI Runtime Center; those
# organization-specific values are AES-256-GCM encrypted in the Connector Vault
# and take priority over these environment variables.
# Examples of compatible providers include DeepSeek API, OpenAI and compatible
# enterprise gateways/newAPI deployments.
OEAP_OPENAI_BASE_URL=
OEAP_OPENAI_MODEL=
OEAP_OPENAI_API_KEY=
OEAP_OPENAI_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# GitHub OAuth
# Callback: <OEAP_PUBLIC_API_URL>/api/auth/github/callback
# -----------------------------------------------------------------------------
OEAP_GITHUB_CLIENT_ID=
OEAP_GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Google Workspace / OpenID Connect
# Callback: <OEAP_PUBLIC_API_URL>/api/auth/google/callback
# -----------------------------------------------------------------------------
OEAP_GOOGLE_CLIENT_ID=
OEAP_GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Microsoft Entra ID / Microsoft 365
# Callback: <OEAP_PUBLIC_API_URL>/api/auth/microsoft/callback
# -----------------------------------------------------------------------------
OEAP_MICROSOFT_CLIENT_ID=
OEAP_MICROSOFT_CLIENT_SECRET=
# Use a tenant ID for organization-only sign-in. Defaults to common.
OEAP_MICROSOFT_TENANT_ID=common

# -----------------------------------------------------------------------------
# Generic enterprise OIDC (Keycloak / Auth0 / Okta / private IdP)
# Callback: <OEAP_PUBLIC_API_URL>/api/auth/oidc/callback
# -----------------------------------------------------------------------------
OEAP_OIDC_ISSUER=
OEAP_OIDC_CLIENT_ID=
OEAP_OIDC_CLIENT_SECRET=
OEAP_OIDC_SCOPE=openid email profile

# -----------------------------------------------------------------------------
# Mail fallback environment variables
# -----------------------------------------------------------------------------
# Enterprise administrators can configure mail providers in the OEAP UI.
# These variables remain available as deployment-level fallbacks.
OEAP_MAIL_PROVIDER=
OEAP_MAIL_FROM=
RESEND_API_KEY=
OEAP_MAIL_WEBHOOK_URL=
OEAP_MAIL_WEBHOOK_TOKEN=
OEAP_SMTP_HOST=
OEAP_SMTP_PORT=587
OEAP_SMTP_SECURE=false
OEAP_SMTP_STARTTLS=true
OEAP_SMTP_REJECT_UNAUTHORIZED=true
OEAP_SMTP_USER=
OEAP_SMTP_PASS=
OEAP_SMTP_FROM=
OEAP_SMTP_HELO=oeap.local
OEAP_SMTP_TIMEOUT_MS=15000
